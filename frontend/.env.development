# Backend API URL
VITE_API_BASE_URL=http://localhost/api

# Application name
VITE_APP_NAME=Langa Dashboard

# Enable debug mode (development only)
VITE_ENABLE_DEBUG=true

# Identity provider (implementations in src/features/auth/providers)
VITE_AUTH_PROVIDER=entra

# Microsoft Entra External ID (example values, see "langa-spa" / "langa-api" app registrations)
VITE_ENTRA_CLIENT_ID=22222222-2222-2222-2222-222222222222
VITE_ENTRA_AUTHORITY=https://langa.ciamlogin.com/
VITE_ENTRA_API_SCOPE=api://11111111-1111-1111-1111-111111111111/access_as_user
