# Backend API URL
VITE_API_BASE_URL=http://localhost/api

# Application name
VITE_APP_NAME=Langa Dashboard

# Enable debug mode (development only)
VITE_ENABLE_DEBUG=true

# Identity provider (implementations in src/features/auth/providers)
VITE_AUTH_PROVIDER=entra

# Microsoft Entra External ID: set VITE_ENTRA_CLIENT_ID, VITE_ENTRA_AUTHORITY and
# VITE_ENTRA_API_SCOPE in .env.local (not versioned, see .env.example).
# Do not define them here: this file takes precedence over .env.local.
