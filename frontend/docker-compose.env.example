# Environment variables for docker-compose
# Copy this file to .env in the same directory as docker-compose.yml

# Docker Registry Configuration
DOCKER_REGISTRY=docker.io
DOCKER_USERNAME=yourusername

# Application Configuration
APP_PORT=3000
VITE_API_BASE_URL=https://api.langa.example.com

# Container Name
CONTAINER_NAME=langa-dashboard

# Optional: Domain for Traefik reverse proxy
DOMAIN=langa.capricedumardi.com

# Microsoft Entra External ID (example values, see "langa-spa" / "langa-api" app registrations)
VITE_ENTRA_CLIENT_ID=22222222-2222-2222-2222-222222222222
VITE_ENTRA_AUTHORITY=https://langa.ciamlogin.com/
VITE_ENTRA_API_SCOPE=api://11111111-1111-1111-1111-111111111111/access_as_user
