# Environment Variables Configuration

# API Configuration
# Base URL for the Langa API backend
VITE_API_BASE_URL=http://localhost:3000/api

# Application Information
VITE_APP_NAME=Langa Dashboard
VITE_APP_VERSION=1.0.0

# Feature Flags (Optional)
# Enable dark mode toggle in UI
VITE_ENABLE_DARK_MODE=false

# Enable analytics tracking
VITE_ENABLE_ANALYTICS=false

# Development Options
# Use mock API instead of real backend (for development/testing)
VITE_MOCK_API=false

# Enable debug logging in console
VITE_DEBUG=false

# Session Configuration
# Session timeout in minutes (default: 60)
VITE_SESSION_TIMEOUT=60

# API timeout in milliseconds (default: 30000)
VITE_API_TIMEOUT=30000

# UI Configuration
# Maximum logs to display per page
VITE_LOGS_PER_PAGE=50

# Maximum metrics data points to fetch
VITE_METRICS_MAX_POINTS=100

# Chart refresh interval in seconds
VITE_CHART_REFRESH_INTERVAL=30

# Security (Production)
# Content Security Policy settings
# VITE_CSP_ENABLED=true

# Note: All VITE_* variables are exposed to the client
# Do NOT put sensitive keys or secrets here
# Backend API handles authentication tokens securely
