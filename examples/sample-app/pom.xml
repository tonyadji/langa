<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.5</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>langa-sample-app</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>langa-sample-app</name>
    <description>Sample Spring Boot application instrumented with the Langa agent</description>

    <properties>
        <java.version>21</java.version>
        <!-- Version of ../../agent, installed locally (mvn install) or from Maven Central -->
        <langa-agent.version>0.0.2-M1</langa-agent.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Required on the classpath by the agent at startup, even for Logback (see the TODO in agent/pom.xml).
             The application keeps logging with Logback: log4j-to-slf4j (from the starter) wins over log4j-core. -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Only for the @Monitored annotation: at runtime the classes come from -javaagent:langa-agent.jar.
             Run from a plain classpath, not the fat jar (see README). -->
        <dependency>
            <groupId>com.capricedumardi</groupId>
            <artifactId>langa-agent</artifactId>
            <version>${langa-agent.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
