# Langa backend - production environment variables (copy to your deployment secrets / .env).
# Variables without a value in this file have no default in application.yml: they are REQUIRED.
# Local development uses the "local" Spring profile (application-local.yml, not versioned) instead.

# --- Application -----------------------------------------------------------------------------------
APP_NAME=langa-backend
SERVER_PORT=8080
BASE_URL=https://api.example.com
# Frontend URL, used in e-mails (invitations, sign-up links)
FRONT_URL=https://app.example.com
# Agent version accepted by the ingestion endpoint (X-USER-AGENT header)
AGENT_VERSION=langa-agent-v1.0.0
PERSISTENCE_PROVIDER=mongo
MULTIPART_MAX_FILE_SIZE=5MB
MULTIPART_MAX_REQUEST_SIZE=5MB
TOMCAT_MAX_FORM_POST_SIZE=5MB

# --- MongoDB ---------------------------------------------------------------------------------------
MONGODB_URI=mongodb://user:password@mongo-host:27017/langa_db?authSource=admin

# --- Authentication (OpenID Connect provider, see README "Authentication") -------------------------
AUTH_PROVIDER=entra
AUTH_ISSUER_URI=https://<tenant-id>.ciamlogin.com/<tenant-id>/v2.0
AUTH_JWK_SET_URI=https://<tenant-subdomain>.ciamlogin.com/<tenant-id>/discovery/v2.0/keys
AUTH_AUDIENCES=<langa-api client id>,api://<langa-api client id>
# Optional (defaults are those of Entra ID)
# AUTH_AUDIENCE_CLAIM=aud
# AUTH_SCOPE_CLAIM=scp
# AUTH_REQUIRED_SCOPE=access_as_user
# AUTH_REQUIRED_CLAIMS=
# AUTH_SUBJECT_CLAIM=oid
# AUTH_EMAIL_SOURCE=claim
# AUTH_EMAIL_CLAIM=email
# AUTH_USERINFO_URI=

# --- HTTP security ---------------------------------------------------------------------------------
# Public endpoints (comma separated). Health probes are always public; the invitation acceptance
# always requires a signed-in user whatever this list contains.
SECURITY_UNSECURED_ENDPOINTS=/api/ingestion/**,/api/team-invitations/*/public
CORS_ALLOWED_ORIGINS=https://app.example.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,HEAD
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=true
CORS_PATTERN_REGISTRY=/**
# Swagger UI / OpenAPI docs (default false in production)
# SPRINGDOC_ENABLED=false
# Health details (never | when-authorized | always), default never
# MANAGEMENT_HEALTH_SHOW_DETAILS=never

# --- Ingestion -------------------------------------------------------------------------------------
INGESTION_ENDPOINT=/api/ingestion
# Optional protection of the public HTTP ingestion endpoint (defaults shown)
# INGESTION_MAX_PAYLOAD_BYTES=5242880
# INGESTION_REQUESTS_PER_MINUTE=1200

# --- Kafka ingestion -------------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka-host:9092
KAFKA_TOPIC=langa
KAFKA_CONSUMER_GROUP_ID=langa-ingestion-group
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_KEY_DESERIALIZER=org.apache.kafka.common.serialization.StringDeserializer
KAFKA_VALUE_DESERIALIZER=org.apache.kafka.common.serialization.StringDeserializer
KAFKA_ENABLE_AUTO_COMMIT=false
KAFKA_TRUSTED_PACKAGES=com.langa.backend.infra.rest.ingest.dto
KAFKA_LISTENER_ACK_MODE=manual_immediate

# --- E-mails (any SMTP server: a transactional provider is recommended in production) --------------
MAIL_PROVIDER=gmail
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
MAIL_STARTTLS_REQUIRED=true

# --- Logging ---------------------------------------------------------------------------------------
LOG_LEVEL_SPRING_WEB=INFO
LOG_LEVEL_SPRING_SECURITY=INFO
LOG_LEVEL_LANGA=INFO
# LOG_LEVEL_KAFKA=OFF
